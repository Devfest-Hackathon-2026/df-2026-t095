{
  "name": "elsewhere",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "google:setup": "node scripts/google/setup.mjs",
    "google:check": "node --env-file=.env.local scripts/google/doctor.mjs",
    "google:rules": "node scripts/google/deploy-rules.mjs",
    "data:climate": "python3 scripts/data/prepare-climate.py",
    "data:factors": "node scripts/data/prepare-place-factors.mjs",
    "data:tourism": "node scripts/data-tourism.mjs",
    "google:catalog": "node --env-file=.env.local scripts/google/setup-catalog.mjs",
    "google:terrain": "node --env-file=.env.local scripts/google/warm-terrain.mjs",
    "data:discover": "node scripts/data/discover-catalog.mjs",
    "data:catalog": "node scripts/data/expand-catalog.mjs",
    "eval:discovery": "node scripts/evaluate-discovery.mjs",
    "catalog:index": "node --env-file=.env.local scripts/visual/build-index.mjs",
    "data:photos": "node --env-file=.env.local scripts/visual/prepare-catalog.mjs"
  },
  "dependencies": {
    "@google/earthengine": "^1.7.51",
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "^13.2.0",
    "geotiff": "^3.0.5",
    "google-auth-library": "^11.3.3",
    "leaflet": "1.9.4",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
