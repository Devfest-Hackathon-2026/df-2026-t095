.cache/*
!.cache/climate
!.cache/commons-embeddings
!.cache/commons-images
!.cache/commons-lookups
!.cache/commons-scenery
!.cache/commons-vision
!.cache/photo-index-v1.json
!.cache/terrain-regions
!.cache/terrain-regions-v3.json
!.cache/terrain-search
