# Files uploaded to Cloud Build. Keep in step with .dockerignore.
node_modules/
.next/
dist/
.git/
.gitignore
.env*
.dev.vars*
.wrangler/
.sites-runtime/
.vinext/
.impeccable/
outputs/
*.tsbuildinfo
*.pem
*.key
*.p12
service-account*.json
credentials*.json

