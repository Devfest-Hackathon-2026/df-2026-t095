# Google Cloud プロジェクト。秘密の値ではありません。
GOOGLE_CLOUD_PROJECT=devfest-hackathon-hexagon
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_EMBEDDING_LOCATION=us

# ローカルでは gcloud auth login の認証を使用します。
# Google に公開するときは false にし、実行用サービスアカウントの ADC を使います。
GOOGLE_AUTH_USE_GCLOUD=true

# Maps JavaScript API とローカルの HTTP リファラーで制限した公開用キー。
GOOGLE_MAPS_BROWSER_KEY=
# Places、Geocoding、Routes に制限したサーバー専用キー。
GOOGLE_MAPS_SERVER_KEY=

# Firebase のウェブ設定。JSON は一重引用符で囲んでください。
# apiKey は Firebase 用の API とローカルのリファラーで制限します。
FIREBASE_WEB_CONFIG='{"apiKey":"","authDomain":"devfest-hackathon-hexagon.firebaseapp.com","projectId":"devfest-hackathon-hexagon","appId":""}'
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5173
