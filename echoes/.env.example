# Server-only key from Google AI Studio. Never use a NEXT_PUBLIC prefix for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Browser key restricted to your app's domains and Maps JavaScript API.
# GOOGLE_MAPS_BROWSER_KEY is read at runtime; NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is also supported.
GOOGLE_MAPS_BROWSER_KEY=
